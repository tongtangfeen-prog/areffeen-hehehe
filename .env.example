# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Admin credentials override for Bibi's Treats Owner Dashboard.
# Leave unset in development to use the first-run owner setup form in the Admin panel.
ADMIN_USERNAME=
ADMIN_PASSWORD=
